#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Run against the dockerised API: `make test-concurrency`. Two modes:
 *
 * - MODE=book (default): fires N concurrent single-seat bookings at one session with capacity M
 *   (N > M) and verifies that exactly M succeed and the session ends with 0 available seats.
 * - MODE=cancel (`make test-concurrency MODE=cancel`): fills a session of capacity M with two
 *   bookings, fires N concurrent cancellations of one of them and verifies that exactly one
 *   succeeds, its seats are released once, and the session cannot then be sold past capacity.
 */

require dirname(__DIR__) . '/vendor/autoload.php';

use Symfony\Component\HttpClient\Exception\TimeoutException;
use Symfony\Component\HttpClient\HttpClient;
use Symfony\Component\Uid\Uuid;
use Symfony\Contracts\HttpClient\Exception\DecodingExceptionInterface;
use Symfony\Contracts\HttpClient\ResponseInterface;

/**
 * The probe measures whether PostgreSQL serialises concurrent bookings. A run that never got
 * answers measures nothing, so it exits non-zero without claiming the API oversold.
 */
function inconclusive(string $reason): never
{
    fwrite(\STDERR, sprintf("INCONCLUSIVE — %s\n", $reason));
    exit(2);
}

/**
 * Narrows a decoded JSON field to string, guarding against an API response that doesn't
 * match the shape this probe expects instead of silently casting `mixed`.
 *
 * @param array<array-key, mixed> $data
 */
function expectString(array $data, string $key): string
{
    $value = $data[$key] ?? null;
    if (!is_string($value)) {
        throw new RuntimeException(sprintf('Expected the API response to include a string "%s".', $key));
    }

    return $value;
}

/**
 * @param array<array-key, mixed> $data
 */
function expectInt(array $data, string $key): int
{
    $value = $data[$key] ?? null;
    if (!is_int($value)) {
        throw new RuntimeException(sprintf('Expected the API response to include an int "%s".', $key));
    }

    return $value;
}

/** The RFC 7807 `type` of an error response, for telling a legitimate 422/503 from any other one. */
function problemType(ResponseInterface $response): string
{
    try {
        $type = $response->toArray(false)['type'] ?? null;
    } catch (DecodingExceptionInterface) {
        return 'non-JSON body';
    }

    return is_string($type) ? $type : 'no problem type';
}

/**
 * MODE=cancel. Concurrent cancellations of one booking must release its seats exactly once: a
 * cancellation that decides on a booking read before its lock releases them again, and the phantom
 * seats are then sold past capacity (README §5).
 */
function cancelProbe(string $baseUrl, int $capacity, int $attempts): never
{
    $cancelledSeats = 2;
    if ($capacity <= $cancelledSeats || $attempts < 2) {
        fwrite(\STDERR, sprintf(
            "MODE=cancel needs CAPACITY > %d (another booking must hold the remaining seats) and ATTEMPTS >= 2 (one cancellation races nothing); got CAPACITY=%d, ATTEMPTS=%d.\n",
            $cancelledSeats,
            $capacity,
            $attempts,
        ));
        exit(1);
    }

    // Same reason as in MODE=book: without raising maxHostConnections, curl would queue the
    // cancellations six at a time in the client instead of at the row lock.
    $http = HttpClient::create(['base_uri' => $baseUrl, 'timeout' => 30], $attempts);

    $experienceId = expectString($http->request('POST', '/api/experiences', ['json' => [
        'title' => 'Cancellation probe ' . date('H:i:s'),
        'description' => 'Simultaneous cancellations of one booking.',
        'providerId' => Uuid::v7()->toRfc4122(),
    ]])->toArray(), 'id');

    $sessionId = expectString($http->request('POST', sprintf('/api/experiences/%s/sessions', $experienceId), ['json' => [
        'startsAt' => (new DateTimeImmutable('+3 days'))->format(\DATE_ATOM),
        'capacity' => $capacity,
        'price' => ['amount' => 1000, 'currency' => 'EUR'],
    ]])->toArray(), 'id');

    $book = static fn(int $seats): ResponseInterface => $http->request('POST', sprintf('/api/sessions/%s/bookings', $sessionId), ['json' => [
        'userId' => Uuid::v7()->toRfc4122(),
        'seats' => $seats,
    ]]);

    // Another booking holds every seat but the ones about to be cancelled. Without it, a second
    // release would drive booked_seats below zero, chk_sessions_booked_seats would reject it, and
    // the race would surface as a 500 instead of as the phantom seats this mode exists to catch.
    $book($capacity - $cancelledSeats)->toArray();
    $reference = expectString($book($cancelledSeats)->toArray(), 'reference');

    printf(
        "Session %s with capacity %d, full (%d + %d seats) — firing %d cancellations of %s (up to %d in flight)…\n",
        $sessionId,
        $capacity,
        $capacity - $cancelledSeats,
        $cancelledSeats,
        $attempts,
        $reference,
        $attempts,
    );

    $responses = [];
    for ($i = 0; $i < $attempts; ++$i) {
        // Registered, not awaited: all of them are resolved concurrently in the stream() loop below.
        $responses[] = $http->request('POST', sprintf('/api/bookings/%s/cancellation', $reference));
    }

    $outcomes = [];
    try {
        foreach ($http->stream($responses) as $response => $chunk) {
            if ($chunk->isFirst()) {
                // Marks the response as checked, so a 4xx/5xx does not throw at the end of the stream.
                $response->getStatusCode();
            }
        }
        foreach ($responses as $response) {
            $code = $response->getStatusCode();
            // Never a bare '200': PHP would turn that numeric-string key into the int 200.
            $outcome = 200 === $code ? 'HTTP 200' : sprintf('HTTP %d %s', $code, problemType($response));
            $outcomes[$outcome] = ($outcomes[$outcome] ?? 0) + 1;
        }

        $afterCancel = $http->request('GET', sprintf('/api/sessions/%s', $sessionId))->toArray();

        // Sell the released seats back one at a time until the API refuses. Correct: exactly
        // $cancelledSeats. More means the counter under-reports what is really sold.
        $rebooked = 0;
        $refusal = 'none';
        for ($i = 0; $i <= $capacity; ++$i) {
            $response = $book(1);
            if (201 !== $response->getStatusCode()) {
                $refusal = sprintf('%d %s', $response->getStatusCode(), problemType($response));
                break;
            }
            ++$rebooked;
        }

        $final = $http->request('GET', sprintf('/api/sessions/%s', $sessionId))->toArray();
    } catch (TimeoutException $e) {
        inconclusive(sprintf(
            "requests timed out before the API answered them (%s).\nLower ATTEMPTS or raise pm.max_children in docker/php/php-fpm.d/.",
            $e->getMessage(),
        ));
    }
    ksort($outcomes);

    $bookedAfterCancel = expectInt($afterCancel, 'bookedSeats');
    $finalBooked = expectInt($final, 'bookedSeats');
    // Every confirmed seat is known: the other booking, plus what the refill got back.
    $confirmedSeats = $capacity - $cancelledSeats + $rebooked;
    $cancelled = $outcomes['HTTP 200'] ?? 0;
    $unexpected = array_diff_key($outcomes, ['HTTP 200' => null, 'HTTP 422 /problems/booking-already-cancelled' => null, 'HTTP 503 /problems/lock-timeout' => null]);

    foreach ($outcomes as $outcome => $count) {
        printf("  %s: %d\n", $outcome, $count);
    }
    printf("Booked seats after the cancellations: %d / %d (expected %d: the %d cancelled seats released once)\n", $bookedAfterCancel, $capacity, $capacity - $cancelledSeats, $cancelledSeats);
    printf("Refill: %d single-seat booking(s) accepted, then %s\n", $rebooked, $refusal);
    printf("Confirmed seats: %d / %d (booked seats: %d)\n", $confirmedSeats, $capacity, $finalBooked);

    if ($cancelled > 1 || $bookedAfterCancel !== $capacity - $cancelledSeats || $confirmedSeats > $capacity || $finalBooked !== $confirmedSeats) {
        echo "FAIL — the booking was cancelled more than once or its seats were released more than once: the session was sold past capacity or lost count.\n";
        exit(1);
    }

    if ([] !== $unexpected) {
        printf("FAIL — unexpected responses: %s.\n", implode(', ', array_keys($unexpected)));
        exit(1);
    }

    if (1 !== $cancelled || array_sum($outcomes) !== $attempts) {
        echo "FAIL — no cancellation succeeded, or some attempts went unanswered.\n";
        exit(1);
    }

    if ($rebooked !== $cancelledSeats || '422 /problems/not-enough-seats-available' !== $refusal) {
        printf("FAIL — the released seats could not be booked back (%d of %d, then %s).\n", $rebooked, $cancelledSeats, $refusal);
        exit(1);
    }

    echo "OK — cancelled exactly once, seats released once, no overbooking.\n";
    exit(0);
}

$baseUrl = getenv('API_BASE_URL') ?: 'http://nginx';
$capacity = (int) (getenv('CAPACITY') ?: 10);
$attempts = (int) (getenv('ATTEMPTS') ?: 60);
$mode = getenv('MODE') ?: 'book';

if ('cancel' === $mode) {
    cancelProbe($baseUrl, $capacity, $attempts);
}

if ('book' !== $mode) {
    fwrite(\STDERR, sprintf("MODE must be \"book\" (default) or \"cancel\", got \"%s\".\n", $mode));
    exit(1);
}

if ($attempts <= $capacity) {
    fwrite(\STDERR, sprintf(
        "ATTEMPTS (%d) must be greater than CAPACITY (%d): with attempts at or below capacity, every request could legitimately succeed and the probe proves nothing about overselling.\n",
        $attempts,
        $capacity,
    ));
    exit(1);
}

// HttpClient::create() defaults maxHostConnections to 6, which would silently cap how many of
// the $attempts requests below can be in flight at once (queuing the rest inside curl, not at
// the row lock). Raise it to $attempts so the requested concurrency is the real concurrency.
$http = HttpClient::create(['base_uri' => $baseUrl, 'timeout' => 30], $attempts);

$experience = $http->request('POST', '/api/experiences', ['json' => [
    'title' => 'Concurrency probe ' . date('H:i:s'),
    'description' => 'Flash-sale simulation.',
    'providerId' => Uuid::v7()->toRfc4122(),
]])->toArray();

$experienceId = expectString($experience, 'id');

$session = $http->request('POST', sprintf('/api/experiences/%s/sessions', $experienceId), ['json' => [
    'startsAt' => (new DateTimeImmutable('+2 days'))->format(\DATE_ATOM),
    'capacity' => $capacity,
    'price' => ['amount' => 1000, 'currency' => 'EUR'],
]])->toArray();
$sessionId = expectString($session, 'id');

printf("Session %s with capacity %d — firing %d bookings (up to %d in flight)…\n", $sessionId, $capacity, $attempts, $attempts);

$responses = [];
for ($i = 0; $i < $attempts; ++$i) {
    // request() is lazy: it only registers the transfer with curl's multi-handle. With
    // maxHostConnections raised to $attempts above, all of them can be handed off together here
    // instead of queuing 6 at a time — resolved concurrently in the stream() loop below.
    $responses[] = $http->request('POST', sprintf('/api/sessions/%s/bookings', $sessionId), ['json' => [
        'userId' => Uuid::v7()->toRfc4122(),
        'seats' => 1,
    ]]);
}

$statuses = [];
try {
    foreach ($http->stream($responses) as $response => $chunk) {
        if ($chunk->isFirst()) {
            // getStatusCode() never throws. Calling it here marks the response as "checked", which
            // stops the client's own end-of-stream safeguard from throwing on a 4xx/5xx later —
            // expected here, since most attempts are supposed to fail with 422/503.
            $response->getStatusCode();
        }
        if ($chunk->isLast()) {
            $code = $response->getStatusCode();
            $statuses[$code] = ($statuses[$code] ?? 0) + 1;
        }
    }

    $final = $http->request('GET', sprintf('/api/sessions/%s', $sessionId))->toArray();
} catch (TimeoutException $e) {
    inconclusive(sprintf(
        "requests timed out before the API answered them (%s).\nWith ATTEMPTS=%d every request queues on php-fpm before it reaches the row lock: lower ATTEMPTS or raise pm.max_children in docker/php/php-fpm.d/.",
        $e->getMessage(),
        $attempts,
    ));
}
ksort($statuses);

$bookedSeats = expectInt($final, 'bookedSeats');
$finalCapacity = expectInt($final, 'capacity');
$availableSeats = expectInt($final, 'availableSeats');

foreach ($statuses as $code => $count) {
    printf("  HTTP %d: %d\n", $code, $count);
}
printf("Booked seats: %d / %d (available: %d)\n", $bookedSeats, $finalCapacity, $availableSeats);

$confirmed = $statuses[201] ?? 0;
$lockTimeouts = $statuses[503] ?? 0;
$unexpected = array_diff_key($statuses, [201 => null, 422 => null, 503 => null]);

// A hard failure means the API let more seats out than it had, or lost count of the ones it did.
// Everything else is either a clean pass or a run that proves nothing.
if ($confirmed > $capacity || $bookedSeats > $finalCapacity || $bookedSeats !== $confirmed || $availableSeats !== $finalCapacity - $bookedSeats) {
    echo "FAIL — overbooking: more seats were confirmed than the session had, or the session lost count.\n";
    exit(1);
}

if ([] !== $unexpected) {
    printf("FAIL — unexpected status codes: %s.\n", implode(', ', array_keys($unexpected)));
    exit(1);
}

if ($finalCapacity !== $capacity || array_sum($statuses) !== $attempts) {
    echo "FAIL — the session under test changed capacity mid-run, or some attempts went unanswered.\n";
    exit(1);
}

if ($confirmed < $capacity && 0 === $lockTimeouts) {
    printf("FAIL — only %d of %d seats were confirmed and nothing timed out: seats were rejected while still available.\n", $confirmed, $capacity);
    exit(1);
}

// README §5.1: under contention a `lock_timeout` is the correct answer, not a bug — but a run that
// answered 503 instead of booking never got as far as proving the seats were serialised.
if ($confirmed < $capacity) {
    inconclusive(sprintf(
        "only %d of %d seats were confirmed because %d request(s) hit the lock timeout (503).\nNo overbooking happened, but the run does not prove the session fills exactly: lower ATTEMPTS or raise pm.max_children.",
        $confirmed,
        $capacity,
        $lockTimeouts,
    ));
}

echo "OK — no overbooking.\n";
exit(0);
