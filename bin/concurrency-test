#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Fires N concurrent single-seat bookings at one session with capacity M (N > M)
 * and verifies that exactly M succeed and the session ends with 0 available seats.
 * Run against the dockerised API: `make test-concurrency`.
 */

require dirname(__DIR__) . '/vendor/autoload.php';

use Symfony\Component\HttpClient\Exception\TimeoutException;
use Symfony\Component\HttpClient\HttpClient;
use Symfony\Component\Uid\Uuid;

/**
 * The probe measures whether PostgreSQL serialises concurrent bookings. A run that never got
 * answers measures nothing, so it exits non-zero without claiming the API oversold.
 */
function inconclusive(string $reason): never
{
    fwrite(\STDERR, sprintf("INCONCLUSIVE — %s\n", $reason));
    exit(2);
}

/**
 * Narrows a decoded JSON field to string, guarding against an API response that doesn't
 * match the shape this probe expects instead of silently casting `mixed`.
 *
 * @param array<array-key, mixed> $data
 */
function expectString(array $data, string $key): string
{
    $value = $data[$key] ?? null;
    if (!is_string($value)) {
        throw new RuntimeException(sprintf('Expected the API response to include a string "%s".', $key));
    }

    return $value;
}

/**
 * @param array<array-key, mixed> $data
 */
function expectInt(array $data, string $key): int
{
    $value = $data[$key] ?? null;
    if (!is_int($value)) {
        throw new RuntimeException(sprintf('Expected the API response to include an int "%s".', $key));
    }

    return $value;
}

$baseUrl = getenv('API_BASE_URL') ?: 'http://nginx';
$capacity = (int) (getenv('CAPACITY') ?: 10);
$attempts = (int) (getenv('ATTEMPTS') ?: 60);

if ($attempts <= $capacity) {
    fwrite(\STDERR, sprintf(
        "ATTEMPTS (%d) must be greater than CAPACITY (%d): with attempts at or below capacity, every request could legitimately succeed and the probe proves nothing about overselling.\n",
        $attempts,
        $capacity,
    ));
    exit(1);
}

// HttpClient::create() defaults maxHostConnections to 6, which would silently cap how many of
// the $attempts requests below can be in flight at once (queuing the rest inside curl, not at
// the row lock). Raise it to $attempts so the requested concurrency is the real concurrency.
$http = HttpClient::create(['base_uri' => $baseUrl, 'timeout' => 30], $attempts);

$experience = $http->request('POST', '/api/experiences', ['json' => [
    'title' => 'Concurrency probe ' . date('H:i:s'),
    'description' => 'Flash-sale simulation.',
    'providerId' => Uuid::v7()->toRfc4122(),
]])->toArray();

$experienceId = expectString($experience, 'id');

$session = $http->request('POST', sprintf('/api/experiences/%s/sessions', $experienceId), ['json' => [
    'startsAt' => (new DateTimeImmutable('+2 days'))->format(\DATE_ATOM),
    'capacity' => $capacity,
    'price' => ['amount' => 1000, 'currency' => 'EUR'],
]])->toArray();
$sessionId = expectString($session, 'id');

printf("Session %s with capacity %d — firing %d bookings (up to %d in flight)…\n", $sessionId, $capacity, $attempts, $attempts);

$responses = [];
for ($i = 0; $i < $attempts; ++$i) {
    // request() is lazy: it only registers the transfer with curl's multi-handle. With
    // maxHostConnections raised to $attempts above, all of them can be handed off together here
    // instead of queuing 6 at a time — resolved concurrently in the stream() loop below.
    $responses[] = $http->request('POST', sprintf('/api/sessions/%s/bookings', $sessionId), ['json' => [
        'userId' => Uuid::v7()->toRfc4122(),
        'seats' => 1,
    ]]);
}

$statuses = [];
try {
    foreach ($http->stream($responses) as $response => $chunk) {
        if ($chunk->isFirst()) {
            // getStatusCode() never throws. Calling it here marks the response as "checked", which
            // stops the client's own end-of-stream safeguard from throwing on a 4xx/5xx later —
            // expected here, since most attempts are supposed to fail with 422/503.
            $response->getStatusCode();
        }
        if ($chunk->isLast()) {
            $code = $response->getStatusCode();
            $statuses[$code] = ($statuses[$code] ?? 0) + 1;
        }
    }

    $final = $http->request('GET', sprintf('/api/sessions/%s', $sessionId))->toArray();
} catch (TimeoutException $e) {
    inconclusive(sprintf(
        "requests timed out before the API answered them (%s).\nWith ATTEMPTS=%d every request queues on php-fpm before it reaches the row lock: lower ATTEMPTS or raise pm.max_children in docker/php/php-fpm.d/.",
        $e->getMessage(),
        $attempts,
    ));
}
ksort($statuses);

$bookedSeats = expectInt($final, 'bookedSeats');
$finalCapacity = expectInt($final, 'capacity');
$availableSeats = expectInt($final, 'availableSeats');

foreach ($statuses as $code => $count) {
    printf("  HTTP %d: %d\n", $code, $count);
}
printf("Booked seats: %d / %d (available: %d)\n", $bookedSeats, $finalCapacity, $availableSeats);

$confirmed = $statuses[201] ?? 0;
$lockTimeouts = $statuses[503] ?? 0;
$unexpected = array_diff_key($statuses, [201 => null, 422 => null, 503 => null]);

// A hard failure means the API let more seats out than it had, or lost count of the ones it did.
// Everything else is either a clean pass or a run that proves nothing.
if ($confirmed > $capacity || $bookedSeats > $finalCapacity || $bookedSeats !== $confirmed || $availableSeats !== $finalCapacity - $bookedSeats) {
    echo "FAIL — overbooking: more seats were confirmed than the session had, or the session lost count.\n";
    exit(1);
}

if ([] !== $unexpected) {
    printf("FAIL — unexpected status codes: %s.\n", implode(', ', array_keys($unexpected)));
    exit(1);
}

if ($finalCapacity !== $capacity || array_sum($statuses) !== $attempts) {
    echo "FAIL — the session under test changed capacity mid-run, or some attempts went unanswered.\n";
    exit(1);
}

if ($confirmed < $capacity && 0 === $lockTimeouts) {
    printf("FAIL — only %d of %d seats were confirmed and nothing timed out: seats were rejected while still available.\n", $confirmed, $capacity);
    exit(1);
}

// README §5.1: under contention a `lock_timeout` is the correct answer, not a bug — but a run that
// answered 503 instead of booking never got as far as proving the seats were serialised.
if ($confirmed < $capacity) {
    inconclusive(sprintf(
        "only %d of %d seats were confirmed because %d request(s) hit the lock timeout (503).\nNo overbooking happened, but the run does not prove the session fills exactly: lower ATTEMPTS or raise pm.max_children.",
        $confirmed,
        $capacity,
        $lockTimeouts,
    ));
}

echo "OK — no overbooking.\n";
exit(0);
